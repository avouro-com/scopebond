{
  "name": "scopebond",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scopebond is an open-source checkpoint for AI coding agents (Claude Code, Cursor, Codex, MCP, GitHub) that blocks out-of-policy actions before they run and signs every decision into a tamper-evident record anyone can verify offline.",
  "license": "Apache-2.0",
  "author": "Avouro LLC",
  "homepage": "https://scopebond.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/avouro-com/scopebond.git"
  },
  "bugs": {
    "url": "https://github.com/avouro-com/scopebond/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "ai-agent-security",
    "claude-code",
    "cursor",
    "openai-codex",
    "mcp",
    "guardrails",
    "policy-enforcement",
    "hooks",
    "github-actions",
    "audit-trail",
    "ed25519"
  ],
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:examples": "node scripts/examples-smoke.mjs",
    "gate": "node scripts/oss-gate.mjs --tree && node scripts/check-release-state.mjs",
    "gate:staged": "node scripts/oss-gate.mjs --staged",
    "check:release-state": "node scripts/check-release-state.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
