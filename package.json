{
  "name": "scopebond",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Free, open-source guardrails and verifiable evidence for AI coding agents: Claude Code, Cursor, Codex, MCP, and GitHub. Scopebond Cloud is a separate proprietary hosted workspace.",
  "license": "Apache-2.0",
  "author": "Avouro LLC",
  "homepage": "https://scopebond.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/avouro-com/scopebond.git"
  },
  "bugs": {
    "url": "https://github.com/avouro-com/scopebond/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "ai-agent-security",
    "claude-code",
    "cursor",
    "openai-codex",
    "mcp",
    "guardrails",
    "policy-enforcement",
    "hooks",
    "github-actions",
    "audit-trail",
    "ed25519"
  ],
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:examples": "node scripts/examples-smoke.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "knip": "knip",
    "gate": "node scripts/oss-gate.mjs --tree && node scripts/check-release-state.mjs",
    "gate:staged": "node scripts/oss-gate.mjs --staged",
    "check:release-state": "node scripts/check-release-state.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version && node scripts/sync-plugin-version.mjs",
    "release": "pnpm -r build && changeset publish",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "publint": "^0.3.25",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
      ".": {},
      "packages/*": {},
      "examples": {
        "entry": [
          "*.mjs"
        ]
      }
    },
    "ignoreDependencies": [
      "@arethetypeswrong/cli",
      "@microsoft/eslint-formatter-sarif",
      "publint"
    ],
    "ignoreBinaries": [
      "reg",
      "icacls",
      "msiexec"
    ]
  }
}
