{
  "name": "scopebond",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scopebond — open-source trust infrastructure for AI agents with delegated authority: a policy-enforcement gateway (prevent, prove) and a collateral registry (pay).",
  "license": "Apache-2.0",
  "author": "Avouro LLC",
  "homepage": "https://scopebond.com",
  "repository": { "type": "git", "url": "https://github.com/avouro-com/scopebond.git" },
  "bugs": { "url": "https://github.com/avouro-com/scopebond/issues" },
  "keywords": ["ai-agents", "agent-security", "policy", "gateway", "mcp", "receipts", "scope", "trust"],
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:examples": "node scripts/examples-smoke.mjs",
    "gate": "node scripts/oss-gate.mjs --tree && node scripts/check-release-state.mjs",
    "gate:staged": "node scripts/oss-gate.mjs --staged",
    "check:release-state": "node scripts/check-release-state.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
