{
  "format": "scopebond:pack/v1",
  "id": "secrets-hygiene",
  "version": "1.0.0",
  "issued_at": "2026-10-21T00:00:00Z",
  "title": "Secrets hygiene: key and environment files, private keyrings",
  "requires": { "engine": 2 },
  "grammars": [
    {
      "id": "ssh-keygen",
      "programs": ["ssh-keygen"],
      "via": "secrets-hygiene",
      "launchers": false,
      "options": {
        "valued": ["-f", "-t", "-b", "-C", "-N", "-P", "-m", "-E", "-O", "-n", "-I", "-V", "-z", "-Z", "-a", "-s", "-w", "-R", "-F", "-D"],
        "flags": ["-q", "-y", "-l", "-H", "-e", "-i", "-p", "-c", "-A", "-k", "-L", "-M", "-Q", "-U", "-v", "-B", "-K"]
      },
      "commands": [
        {
          "path": [],
          "when": { "not": { "has": ["-l", "-y", "-R", "-F", "-H", "-e", "-i", "-B", "-L", "-Q", "-k", "-D"] } },
          "emit": [
            { "action_type": "file.write", "when": { "defined": { "flag": ["-f"] } },
              "params": { "path": { "flag": ["-f"] }, "operation": { "const": "key-generate" } } },
            { "action_type": "file.write", "when": { "all": [{ "not": { "defined": { "flag": ["-f"] } } }, { "not": { "has": ["-A"] } }] },
              "params": { "path": { "concat": ["~/.ssh/id_", { "first": [{ "lower": { "flag": ["-t"] } }, { "const": "ed25519" }] }] }, "operation": { "const": "key-generate" } } }
          ]
        }
      ]
    },
    {
      "id": "openssl",
      "programs": ["openssl"],
      "via": "secrets-hygiene",
      "launchers": false,
      "options": {
        "valued": ["-keyout", "-out", "-in", "-newkey", "-days", "-subj", "-config", "-passout", "-passin", "-pkeyopt", "-algorithm", "-name", "-inform", "-outform", "-key", "-CA", "-CAkey", "-set_serial", "-extensions", "-extfile", "-certfile", "-inkey"],
        "flags": ["-nodes", "-noenc", "-new", "-x509", "-text", "-noout", "-verify", "-batch", "-sha256", "-des3", "-aes256", "-export", "-pubout"]
      },
      "commands": [
        {
          "path": [{ "any": ["req", "pkcs12", "x509", "ca"] }],
          "emit": [{ "action_type": "file.write", "when": { "defined": { "flag": ["-keyout"] } },
            "params": { "path": { "flag": ["-keyout"] }, "operation": { "const": "key-generate" } } }]
        }
      ]
    },
    {
      "id": "gpg",
      "programs": ["gpg", "gpg2"],
      "via": "secrets-hygiene",
      "launchers": false,
      "options": {
        "valued": ["--output", "-o", "--homedir", "--local-user", "-u", "--recipient", "-r", "--passphrase-fd", "--pinentry-mode"],
        "flags": ["--export-secret-keys", "--export-secret-subkeys", "--armor", "-a", "--batch", "--yes", "--export", "--list-keys", "-k", "--list-secret-keys", "-K"]
      },
      "commands": [
        {
          "path": [],
          "when": { "has": ["--export-secret-keys", "--export-secret-subkeys"] },
          "emit": [
            { "action_type": "file.read", "params": { "path": { "first": [{ "flag": ["--homedir"] }, { "const": "~/.gnupg" }] }, "operation": { "const": "key-export" } } },
            { "action_type": "file.write", "when": { "defined": { "flag": ["--output", "-o"] } },
              "params": { "path": { "flag": ["--output", "-o"] }, "operation": { "const": "key-export" } } }
          ]
        }
      ]
    }
  ],
  "profiles": [],
  "rules": [
    {
      "id": "env-file-write",
      "type": "action_allowlist",
      "mode": "monitor",
      "action_types": ["file.write"],
      "param_bounds": { "path": { "pattern": "^(?:(?!(?:.*/)?\\.[eE][nN][vV](?:\\.[^/]*)?$)|.*\\.(?:example|sample|template|dist)$)" } },
      "title": "Environment file written",
      "blockable": true,
      "default_mode": "monitor",
      "safer_way": "Write the names the project needs to .env.example and leave the values to the person.",
      "description": "Record writes to environment files (.env, .env.local, .env.production), where secret values live. Templates (.example, .sample, .template, .dist) are not matched."
    },
    {
      "id": "key-file-write",
      "type": "action_allowlist",
      "mode": "monitor",
      "action_types": ["file.write"],
      "param_bounds": { "path": { "pattern": "^(?!(?:.*/)?(?:[^/]*\\.(?:pem|key|p12|pfx|jks|keystore|PEM|KEY|P12|PFX)|id_(?:rsa|ecdsa|ed25519|dsa)|\\.netrc|\\.pypirc|\\.git-credentials)$)" } },
      "title": "Key or credential file written",
      "blockable": true,
      "default_mode": "monitor",
      "safer_way": "Ask the person to create keys and credential files themselves, outside the project.",
      "description": "Record writes of private keys and credential files: *.pem, *.key, *.p12, *.pfx, *.jks, SSH private keys (id_rsa, id_ed25519, …), .netrc, .pypirc and .git-credentials, including the files ssh-keygen and openssl write."
    },
    {
      "id": "private-keyring-read",
      "type": "action_allowlist",
      "mode": "monitor",
      "action_types": ["file.read"],
      "param_bounds": { "path": { "pattern": "^(?!(?:.*/)?\\.gnupg(?:/|$))" } },
      "title": "Private keyring read",
      "blockable": true,
      "default_mode": "block",
      "safer_way": "Export public keys only (gpg --export); a private key never needs to leave the keyring for a coding task.",
      "description": "Block exporting private keys from a keyring (gpg --export-secret-keys) and reading the files of ~/.gnupg."
    }
  ],
  "vectors": [
    { "id": "ssh-keygen-named-file", "shell": { "command": "ssh-keygen -t ed25519 -f deploy_key -N ''" },
      "expect": [{ "action_type": "file.write", "params": { "path": "deploy_key", "operation": "key-generate", "via": "secrets-hygiene", "derived_from": "shell.exec" } }] },
    { "id": "ssh-keygen-home-key", "shell": { "command": "ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa -q -N ''" },
      "expect": [{ "action_type": "file.write", "params": { "path": "~/.ssh/id_rsa", "operation": "key-generate", "via": "secrets-hygiene", "derived_from": "shell.exec" } }] },
    { "id": "ssh-keygen-default-file", "shell": { "command": "ssh-keygen -t ECDSA" },
      "expect": [{ "action_type": "file.write", "params": { "path": "~/.ssh/id_ecdsa", "operation": "key-generate", "via": "secrets-hygiene", "derived_from": "shell.exec" } }] },
    { "id": "ssh-keygen-fingerprint", "shell": { "command": "ssh-keygen -l -f deploy_key.pub" }, "expect": [] },
    { "id": "ssh-keygen-public-from-private", "shell": { "command": "ssh-keygen -y -f deploy_key" }, "expect": [] },
    { "id": "ssh-keygen-known-hosts", "shell": { "command": "ssh-keygen -R example.com" }, "expect": [] },
    { "id": "openssl-request-with-key", "shell": { "command": "openssl req -new -newkey rsa:2048 -nodes -keyout server.key -out server.csr -subj /CN=localhost" },
      "expect": [{ "action_type": "file.write", "params": { "path": "server.key", "operation": "key-generate", "via": "secrets-hygiene", "derived_from": "shell.exec" } }] },
    { "id": "openssl-self-signed", "shell": { "command": "openssl req -x509 -newkey rsa:4096 -keyout certs/dev.key -out certs/dev.crt -days 30 -nodes" },
      "expect": [{ "action_type": "file.write", "params": { "path": "certs/dev.key", "operation": "key-generate", "via": "secrets-hygiene", "derived_from": "shell.exec" } }] },
    { "id": "openssl-show-certificate", "shell": { "command": "openssl x509 -in cert.pem -noout -text" }, "expect": [] },
    { "id": "openssl-genpkey-is-read-by-the-open-detection", "shell": { "command": "openssl genpkey -algorithm ed25519 -out k.pem" }, "expect": [] },
    { "id": "gpg-export-secret-to-file", "shell": { "command": "gpg --export-secret-keys --armor --output backup.asc" },
      "expect": [
        { "action_type": "file.read", "params": { "path": "~/.gnupg", "operation": "key-export", "via": "secrets-hygiene", "derived_from": "shell.exec" } },
        { "action_type": "file.write", "params": { "path": "backup.asc", "operation": "key-export", "via": "secrets-hygiene", "derived_from": "shell.exec" } }
      ] },
    { "id": "gpg-export-secret-to-screen", "shell": { "command": "gpg -a --export-secret-subkeys" },
      "expect": [{ "action_type": "file.read", "params": { "path": "~/.gnupg", "operation": "key-export", "via": "secrets-hygiene", "derived_from": "shell.exec" } }] },
    { "id": "gpg-other-home", "shell": { "command": "gpg --homedir ./keys --export-secret-keys -o out.asc" },
      "expect": [
        { "action_type": "file.read", "params": { "path": "./keys", "operation": "key-export", "via": "secrets-hygiene", "derived_from": "shell.exec" } },
        { "action_type": "file.write", "params": { "path": "out.asc", "operation": "key-export", "via": "secrets-hygiene", "derived_from": "shell.exec" } }
      ] },
    { "id": "gpg-public-export", "shell": { "command": "gpg --export --armor me@example.com" }, "expect": [] },
    { "id": "gpg-list", "shell": { "command": "gpg --list-secret-keys" }, "expect": [] }
  ]
}
