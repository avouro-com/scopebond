{
  "tool": "kubectl",
  "description": "kubectl: apply/create/replace/patch/scale/set/rollout and the other changing verbs (k8s.apply), delete (k8s.delete), exec/attach/debug (k8s.exec). --context and -n/--namespace are recorded; resource names are digested with them; a client or server dry run derives nothing.",
  "cases": [
    {
      "name": "apply from a file in a named context and namespace",
      "command": "kubectl --context prod-cluster -n payments apply -f k8s/deployment.yaml",
      "expect": [{ "action_type": "k8s.apply", "params": { "context": "prod-cluster", "namespace": "payments", "risk_class": "sensitive" } }]
    },
    {
      "name": "delete two pods by name",
      "command": "kubectl -n payments delete pod api-1 api-2",
      "expect": [{ "action_type": "k8s.delete", "params": { "namespace": "payments", "kind": "pod", "name_digest": { "$digest": ["k8s", "", "payments", "pod", "api-1", "api-2"] }, "risk_class": "destructive" } }]
    },
    {
      "name": "delete --all of a kind, short name normalized",
      "command": "kubectl delete po --all --namespace=staging",
      "expect": [{ "action_type": "k8s.delete", "params": { "namespace": "staging", "kind": "pod", "all": true, "risk_class": "destructive" } }]
    },
    {
      "name": "delete a namespace written kind/name",
      "command": "kubectl delete ns/feature-x --context=dev",
      "expect": [{ "action_type": "k8s.delete", "params": { "context": "dev", "kind": "namespace", "name_digest": { "$digest": ["k8s", "dev", "", "namespace", "feature-x"] }, "risk_class": "destructive" } }]
    },
    {
      "name": "delete from a file names no objects",
      "command": "kubectl delete -f k8s/",
      "expect": [{ "action_type": "k8s.delete", "params": { "risk_class": "destructive" } }]
    },
    {
      "name": "exec into a pod",
      "command": "kubectl exec -it api-7c9 -n payments -- sh -c 'env'",
      "expect": [{ "action_type": "k8s.exec", "params": { "namespace": "payments", "kind": "pod", "name_digest": { "$digest": ["k8s", "", "payments", "pod", "api-7c9"] }, "risk_class": "destructive" } }]
    },
    {
      "name": "exec into a deployment",
      "command": "kubectl exec deploy/api -- printenv",
      "expect": [{ "action_type": "k8s.exec", "params": { "kind": "deployment", "name_digest": { "$digest": ["k8s", "", "", "deployment", "api"] }, "risk_class": "destructive" } }]
    },
    {
      "name": "scale a deployment",
      "command": "kubectl scale deployment/api --replicas=0 -n payments",
      "expect": [{ "action_type": "k8s.apply", "params": { "namespace": "payments", "kind": "deployment", "name_digest": { "$digest": ["k8s", "", "payments", "deployment", "api"] }, "risk_class": "sensitive" } }]
    },
    {
      "name": "rollout restart",
      "command": "kubectl rollout restart deployment api",
      "expect": [{ "action_type": "k8s.apply", "params": { "kind": "deployment", "name_digest": { "$digest": ["k8s", "", "", "deployment", "api"] }, "risk_class": "sensitive" } }]
    },
    { "name": "a client dry run derives nothing", "command": "kubectl apply -f k8s/ --dry-run=client", "expect": [] },
    { "name": "a server dry run derives nothing", "command": "kubectl delete pod api-1 --dry-run=server", "expect": [] },
    { "name": "get derives nothing", "command": "kubectl get pods -A", "expect": [] },
    { "name": "logs derive nothing", "command": "kubectl logs -f api-1 -n payments", "expect": [] },
    { "name": "rollout status derives nothing", "command": "kubectl rollout status deployment/api", "expect": [] },
    { "name": "diff derives nothing", "command": "kubectl diff -f k8s/", "expect": [] }
  ]
}
