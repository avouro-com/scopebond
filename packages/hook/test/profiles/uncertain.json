{
  "tool": "uncertain",
  "description": "An option the reader does not know, placed before the subcommand (or anywhere, for wrangler), stops it reading the command. When one of the tool's destructive words is among the command's words, the action is still derived, with every name left out and a deployment's environment unknown. Package runners' own options that take a value are skipped, and help is help only in the subcommand slot.",
  "cases": [
    {
      "name": "kubectl: an unknown option before delete",
      "via": "kubectl",
      "command": "kubectl --warnings-as-errors delete ns prod",
      "expect": [{ "action_type": "k8s.delete", "params": { "risk_class": "destructive" } }]
    },
    {
      "name": "kubectl: an unknown option before exec",
      "via": "kubectl",
      "command": "kubectl --mystery x exec -it api-1 -- sh",
      "expect": [{ "action_type": "k8s.exec", "params": { "risk_class": "destructive" } }]
    },
    {
      "name": "gcloud: an unknown option before the command path",
      "via": "gcloud",
      "command": "gcloud --unknown compute instances delete vm1",
      "expect": [{ "action_type": "cloud.resource.delete", "params": { "provider": "gcp", "risk_class": "destructive" } }]
    },
    {
      "name": "helm: an unknown option before uninstall",
      "via": "helm",
      "command": "helm --unknown uninstall rel",
      "expect": [{ "action_type": "k8s.delete", "params": { "kind": "helm-release", "risk_class": "destructive" } }]
    },
    {
      "name": "fly: an unknown option before destroy",
      "via": "fly",
      "command": "fly --unknown destroy app",
      "expect": [{ "action_type": "cloud.resource.delete", "params": { "provider": "fly", "risk_class": "destructive" } }]
    },
    {
      "name": "fly: an unknown option before deploy",
      "via": "fly",
      "command": "fly --unknown deploy",
      "expect": [{ "action_type": "deploy.release", "params": { "provider": "fly", "environment": "unknown", "risk_class": "destructive" } }]
    },
    {
      "name": "aws: --cli-error-format is a global option that takes a value",
      "via": "aws",
      "command": "aws --cli-error-format json s3 rb s3://b --force",
      "expect": [{ "action_type": "cloud.resource.delete", "params": { "provider": "aws", "service": "s3", "kind": "bucket", "resource_digest": { "$digest": ["aws", "s3", "b"] }, "auto_approve": true, "risk_class": "destructive" } }]
    },
    {
      "name": "aws: an unknown global option before an iam delete",
      "via": "aws",
      "command": "aws --mystery x iam delete-role --role-name admin",
      "expect": [{ "action_type": "iam.change", "params": { "provider": "aws", "kind": "other", "risk_class": "identity" } }]
    },
    {
      "name": "aws: help as an option's value is a name, not help",
      "via": "aws",
      "command": "aws iam delete-role --role-name help",
      "expect": [{ "action_type": "iam.change", "params": { "provider": "aws", "kind": "role", "name_digest": { "$digest": ["aws", "iam", "role", "help"] }, "risk_class": "identity" } }]
    },
    {
      "name": "wrangler: an unknown option after deploy",
      "via": "wrangler",
      "command": "wrangler deploy --x-unknown",
      "expect": [{ "action_type": "deploy.release", "params": { "provider": "cloudflare", "environment": "unknown", "risk_class": "destructive" } }]
    },
    {
      "name": "vercel: an unknown option, no subcommand, is a deployment",
      "via": "vercel",
      "command": "vercel --mystery",
      "expect": [{ "action_type": "deploy.release", "params": { "provider": "vercel", "environment": "unknown", "risk_class": "destructive" } }]
    },
    {
      "name": "prisma through pnpm --filter",
      "via": "prisma",
      "command": "pnpm --filter db exec prisma migrate reset",
      "expect": [{ "action_type": "db.migrate", "params": { "provider": "prisma", "direction": "reset", "risk_class": "destructive" } }]
    },
    {
      "name": "prisma through npm exec -w",
      "via": "prisma",
      "command": "npm exec -w api -- prisma migrate reset",
      "expect": [{ "action_type": "db.migrate", "params": { "provider": "prisma", "direction": "reset", "risk_class": "destructive" } }]
    },
    {
      "name": "prisma: an unknown option before the subcommand",
      "via": "prisma",
      "command": "prisma --schema db/schema.prisma migrate reset",
      "expect": [{ "action_type": "db.migrate", "params": { "provider": "prisma", "direction": "reset", "risk_class": "destructive" } }]
    },
    {
      "name": "alembic through uv run --env-file",
      "via": "alembic",
      "command": "uv run --env-file .env alembic downgrade base",
      "expect": [{ "action_type": "db.migrate", "params": { "provider": "alembic", "direction": "down", "risk_class": "destructive" } }]
    },
    {
      "name": "alembic through python with its own options",
      "via": "alembic",
      "command": "python -I -m alembic downgrade -1",
      "expect": [{ "action_type": "db.migrate", "params": { "provider": "alembic", "direction": "down", "risk_class": "destructive" } }]
    },
    {
      "name": "knex: --env takes a value before the subcommand",
      "via": "knex",
      "command": "knex --env production migrate:rollback",
      "expect": [{ "action_type": "db.migrate", "params": { "provider": "knex", "direction": "down", "risk_class": "destructive" } }]
    },
    { "name": "an unknown option on a read derives nothing", "via": "kubectl", "command": "kubectl --warnings-as-errors get pods", "expect": [] },
    { "name": "an unknown option and a dry run derive nothing", "via": "kubectl", "command": "kubectl --mystery delete pod a --dry-run=client", "expect": [] },
    { "name": "an unknown option and help derive nothing", "via": "helm", "command": "helm --mystery uninstall rel --help", "expect": [] },
    { "name": "help in the subcommand slot derives nothing", "via": "fly", "command": "fly --mystery help destroy", "expect": [] },
    { "name": "a destructive word after -- is the container's command, not kubectl's", "via": "kubectl", "command": "kubectl --mystery logs api-1 -- delete", "expect": [] },
    { "name": "an unknown option on a local gcloud group derives nothing", "via": "gcloud", "command": "gcloud --mystery config configurations delete old", "expect": [] }
  ]
}
