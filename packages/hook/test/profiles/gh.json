{
  "tool": "gh",
  "description": "GitHub CLI: secret set (secret.write, store github; the value never read), repo delete (cloud.resource.delete, provider github), and api (net.fetch with the method). Pull request and release commands keep their typed GitHub operations and derive nothing here.",
  "cases": [
    {
      "name": "secret set for the current repository",
      "command": "gh secret set NPM_TOKEN --body {{SECRET}}",
      "expect": [{ "action_type": "secret.write", "params": { "store": "github", "name_digest": { "$digest": ["github", "", "", "NPM_TOKEN"] }, "risk_class": "sensitive" } }]
    },
    {
      "name": "secret set for an environment of another repository",
      "command": "gh secret set DEPLOY_KEY -R acme/web --env production < key.txt",
      "expect": [{ "action_type": "secret.write", "params": { "store": "github", "name_digest": { "$digest": ["github", "acme/web", "production", "DEPLOY_KEY"] }, "env": "production", "risk_class": "sensitive" } }]
    },
    {
      "name": "secret set for an organization",
      "command": "gh secret set SHARED --org acme --visibility all --body {{SECRET}}",
      "expect": [{ "action_type": "secret.write", "params": { "store": "github", "name_digest": { "$digest": ["github", "acme", "", "SHARED"] }, "risk_class": "sensitive" } }]
    },
    {
      "name": "secret set from an env file names no single secret",
      "command": "gh secret set -f .env.ci",
      "expect": [{ "action_type": "secret.write", "params": { "store": "github", "risk_class": "sensitive" } }]
    },
    {
      "name": "repo delete",
      "command": "gh repo delete acme/old-site --yes",
      "expect": [{ "action_type": "cloud.resource.delete", "params": { "provider": "github", "service": "repo", "kind": "repo", "resource_digest": { "$digest": ["github", "repo", "acme/old-site"] }, "auto_approve": true, "risk_class": "destructive" } }]
    },
    {
      "name": "repo delete of the current repository names none",
      "command": "gh repo delete",
      "expect": [{ "action_type": "cloud.resource.delete", "params": { "provider": "github", "service": "repo", "kind": "repo", "risk_class": "destructive" } }]
    },
    {
      "name": "api DELETE",
      "command": "gh api -X DELETE repos/acme/web/branches/main/protection",
      "expect": [{ "action_type": "net.fetch", "params": { "host": "api.github.com", "method": "DELETE" } }]
    },
    {
      "name": "api with fields is a POST",
      "command": "gh api repos/acme/web/issues -f title=Bug",
      "expect": [{ "action_type": "net.fetch", "params": { "host": "api.github.com", "method": "POST" } }]
    },
    {
      "name": "api on an enterprise host",
      "command": "gh api --hostname git.acme.example --method PATCH repos/acme/web",
      "expect": [{ "action_type": "net.fetch", "params": { "host": "git.acme.example", "method": "PATCH" } }]
    },
    {
      "name": "graphql is a POST",
      "command": "gh api graphql -F owner=acme",
      "expect": [{ "action_type": "net.fetch", "params": { "host": "api.github.com", "method": "POST" } }]
    },
    { "name": "pr create derives nothing here", "command": "gh pr create --base main --title x --body y", "expect": [] },
    { "name": "secret list derives nothing", "command": "gh secret list", "expect": [] },
    { "name": "repo view derives nothing", "command": "gh repo view acme/web", "expect": [] }
  ]
}
