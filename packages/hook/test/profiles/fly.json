{
  "tool": "fly",
  "description": "Fly.io (fly or flyctl): deploy, secrets set (one write per NAME=value, the value never read) and import, and destroying apps, machines and volumes. The app name sets the environment when its words say one.",
  "cases": [
    {
      "name": "deploy a production app",
      "command": "fly deploy -a acme-api-prod --remote-only",
      "expect": [{ "action_type": "deploy.release", "params": { "provider": "fly", "environment": "production", "target_digest": { "$digest": ["fly", "acme-api-prod"] }, "risk_class": "destructive" } }]
    },
    {
      "name": "flyctl deploy with no app named",
      "command": "flyctl deploy",
      "expect": [{ "action_type": "deploy.release", "params": { "provider": "fly", "environment": "unknown", "risk_class": "destructive" } }]
    },
    {
      "name": "secrets set writes each name once",
      "command": "fly secrets set DATABASE_URL={{SECRET}} API_KEY={{SECRET}} -a acme-api-staging",
      "expect": [
        { "action_type": "secret.write", "params": { "store": "fly", "name_digest": { "$digest": ["fly", "acme-api-staging", "DATABASE_URL"] }, "env": "staging", "risk_class": "sensitive" } },
        { "action_type": "secret.write", "params": { "store": "fly", "name_digest": { "$digest": ["fly", "acme-api-staging", "API_KEY"] }, "env": "staging", "risk_class": "sensitive" } }
      ]
    },
    {
      "name": "secrets import",
      "command": "fly secrets import -a acme-api",
      "expect": [{ "action_type": "secret.write", "params": { "store": "fly", "risk_class": "sensitive" } }]
    },
    {
      "name": "apps destroy",
      "command": "fly apps destroy acme-old --yes",
      "expect": [{ "action_type": "cloud.resource.delete", "params": { "provider": "fly", "service": "apps", "kind": "app", "resource_digest": { "$digest": ["fly", "app", "acme-old"] }, "auto_approve": true, "risk_class": "destructive" } }]
    },
    {
      "name": "machine destroy",
      "command": "fly machine destroy 148ed726c11789 --force -a acme-api",
      "expect": [{ "action_type": "cloud.resource.delete", "params": { "provider": "fly", "service": "machines", "kind": "machine", "resource_digest": { "$digest": ["fly", "machine", "148ed726c11789"] }, "auto_approve": true, "risk_class": "destructive" } }]
    },
    { "name": "status derives nothing", "command": "fly status -a acme-api", "expect": [] },
    { "name": "secrets list derives nothing", "command": "fly secrets list -a acme-api", "expect": [] },
    { "name": "logs derive nothing", "command": "fly logs -a acme-api", "expect": [] }
  ]
}
