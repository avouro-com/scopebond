{
  "name": "@scopebond/hook",
  "version": "0.31.2",
  "description": "See and block what Claude Code, Cursor, OpenAI Codex and GitHub Copilot do. Monitor or Block rules and a signed record for each action. Open source (Apache-2.0); works without an account.",
  "license": "Apache-2.0",
  "author": "Avouro LLC",
  "homepage": "https://github.com/avouro-com/scopebond/tree/main/packages/hook#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/avouro-com/scopebond.git",
    "directory": "packages/hook"
  },
  "bugs": {
    "url": "https://github.com/avouro-com/scopebond/issues"
  },
  "keywords": [
    "scopebond",
    "claude-code",
    "cursor",
    "openai-codex",
    "hooks",
    "ai-agents",
    "policy"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "scopebond": "dist/cli.js",
    "scopebond-hook": "dist/cli.js"
  },
  "files": [
    "dist",
    "packs"
  ],
  "dependencies": {
    "@scopebond/gateway": "workspace:^",
    "@scopebond/policy-schema": "workspace:^",
    "@scopebond/sdk": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-timeout=300000 test/*.test.mjs test/*.test.js && node --test --test-timeout=1800000 test/windows-journey.run.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@scopebond/fake-cloud": "workspace:*",
    "@scopebond/verify": "workspace:*",
    "fast-check": "^4.10.2"
  }
}
