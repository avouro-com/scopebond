{
  "name": "@scopebond/verify",
  "version": "0.6.0",
  "description": "Open-source deterministic policy evaluation and evidence verification for Scopebond action records, with portable conformance vectors.",
  "license": "Apache-2.0",
  "author": "Avouro LLC",
  "homepage": "https://github.com/avouro-com/scopebond/tree/main/packages/verify#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/avouro-com/scopebond.git",
    "directory": "packages/verify"
  },
  "bugs": {
    "url": "https://github.com/avouro-com/scopebond/issues"
  },
  "keywords": [
    "scopebond",
    "verify",
    "policy",
    "ai-agents",
    "verdict",
    "receipts"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/violates.js",
  "types": "dist/violates.d.ts",
  "exports": {
    ".": {
      "types": "./dist/violates.d.ts",
      "default": "./dist/violates.js"
    },
    "./signature": {
      "types": "./dist/signature.d.ts",
      "default": "./dist/signature.js"
    },
    "./anchor": {
      "types": "./dist/anchor.d.ts",
      "default": "./dist/anchor.js"
    },
    "./summary": {
      "types": "./dist/summary.d.ts",
      "default": "./dist/summary.js"
    }
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@scopebond/policy-schema": "workspace:^"
  }
}
