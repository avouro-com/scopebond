{
  "name": "@scopebond/gateway",
  "version": "0.20.6",
  "description": "Self-hosted gateway for agent actions sent over HTTP and MCP. Checks each action against your rules, blocks what they say to block, and signs a record. Open source (Apache-2.0).",
  "license": "Apache-2.0",
  "author": "Avouro LLC",
  "homepage": "https://github.com/avouro-com/scopebond/tree/main/packages/gateway#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/avouro-com/scopebond.git",
    "directory": "packages/gateway"
  },
  "bugs": {
    "url": "https://github.com/avouro-com/scopebond/issues"
  },
  "keywords": [
    "scopebond",
    "gateway",
    "ai-agents",
    "mcp",
    "policy",
    "proxy",
    "receipts"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "bin": {
    "scopebond-gateway": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@scopebond/policy-schema": "workspace:^",
    "@scopebond/verify": "workspace:*",
    "hono": "^4.13.12",
    "@hono/node-server": "^2.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@scopebond/sdk": "workspace:*",
    "@scopebond/fake-cloud": "workspace:*"
  }
}
