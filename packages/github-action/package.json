{
  "name": "@scopebond/github-action",
  "version": "0.4.0",
  "description": "Scopebond for GitHub — check an agent pull request against your policy in your own Actions runner before it can merge. The boundary-lane connector's customer-side runner (no GitHub SDK; no Scopebond-held credential).",
  "license": "Apache-2.0",
  "author": "Avouro LLC",
  "homepage": "https://github.com/avouro-com/scopebond/tree/main/packages/github-action#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/avouro-com/scopebond.git",
    "directory": "packages/github-action"
  },
  "bugs": {
    "url": "https://github.com/avouro-com/scopebond/issues"
  },
  "keywords": [
    "scopebond",
    "github",
    "ai-agents",
    "pull-request",
    "policy",
    "boundary"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "scopebond-verify-pr": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "dependencies": {
    "@scopebond/policy-schema": "workspace:^",
    "@scopebond/verify": "workspace:^",
    "@scopebond/gateway": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
