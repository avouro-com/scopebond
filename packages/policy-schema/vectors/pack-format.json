{
  "description": "Pack format conformance (scopebond:pack/v1). Each case changes one thing in example-pack.json: `set` puts `value` at `path` (array of keys and indexes), `delete` removes the member at `path`. `valid` is what validatePack must say. `schema` is what pack.schema.json alone says when it differs: some rules are cross-field or about regular expressions, which only the validator checks.",
  "cases": [
    { "name": "the example pack", "valid": true },
    { "name": "a title is optional", "delete": ["title"], "valid": true },
    { "name": "no rules and no profiles", "set": ["rules"], "value": [], "valid": true },
    { "name": "unknown top-level field", "set": ["expires_at"], "value": "2027-01-01T00:00:00Z", "valid": false },
    { "name": "wrong format", "set": ["format"], "value": "scopebond:pack/v2", "valid": false },
    { "name": "version is MAJOR.MINOR.PATCH", "set": ["version"], "value": "1.0", "valid": false },
    { "name": "issued_at is UTC with Z", "set": ["issued_at"], "value": "2026-10-01T00:00:00+02:00", "valid": false },
    { "name": "signature algorithm", "set": ["signature", "alg"], "value": "RS256", "valid": false },
    { "name": "signature value shape", "set": ["signature", "value"], "value": "abc", "valid": false },
    { "name": "missing signature", "delete": ["signature"], "valid": false },
    { "name": "at least one vector", "set": ["vectors"], "value": [], "valid": false },
    { "name": "unknown grammar field", "set": ["grammars", 0, "eval"], "value": "x", "valid": false },
    { "name": "unknown expression operator", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "provider"], "value": { "eval": "process.exit()" }, "valid": false },
    { "name": "an operator with a modifier of another operator", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "provider"], "value": { "flag": ["--x"], "pattern": "x" }, "valid": false },
    { "name": "an MCP operator in a grammar", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "provider"], "value": { "arg": ["x"] }, "valid": false },
    { "name": "a command-line operator in a profile", "set": ["profiles", 0, "tools", 0, "emit", 0, "params", "provider"], "value": { "flag": ["--x"] }, "valid": false },
    { "name": "a command-line condition in a profile", "set": ["profiles", 0, "tools", 0, "when"], "value": { "has": ["--x"] }, "valid": false },
    { "name": "emitting the call itself", "set": ["grammars", 0, "commands", 1, "emit", 0, "action_type"], "value": "shell.exec", "valid": false },
    { "name": "an unregistered action type", "set": ["grammars", 0, "commands", 1, "emit", 0, "action_type"], "value": "made.up", "valid": false, "schema": true },
    { "name": "a parameter the engine sets", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "via"], "value": { "const": "x" }, "valid": false },
    { "name": "a repeated group that holds a repeat", "set": ["grammars", 0, "commands", 2, "path", 0, "pattern"], "value": "^(a+)+$", "valid": false, "schema": true },
    { "name": "a back-reference", "set": ["grammars", 0, "commands", 2, "path", 0, "pattern"], "value": "^(a)\\1$", "valid": false, "schema": true },
    { "name": "a pattern that does not parse", "set": ["grammars", 0, "commands", 2, "path", 0, "pattern"], "value": "(", "valid": false, "schema": true },
    { "name": "an option name without a dash", "set": ["grammars", 0, "options", "valued", 0], "value": "region", "valid": false },
    { "name": "a path word that both matches a list and skips", "set": ["grammars", 0, "commands", 1, "path", 1], "value": { "any": ["rm"], "skip": 2 }, "valid": false, "schema": true },
    { "name": "map takes keep or default, not both", "set": ["grammars", 0, "commands", 3, "emit", 0, "params", "kind", "default"], "value": { "const": "x" }, "valid": false, "schema": true },
    { "name": "present.or may only be false", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "auto_approve", "or"], "value": true, "valid": false },
    { "name": "a rule that is not an action_allowlist", "set": ["rules", 0, "type"], "value": "rate_limit", "valid": false },
    { "name": "a rule with an unknown field", "set": ["rules", 0, "severity"], "value": "high", "valid": false },
    { "name": "a rule bound with an unknown key", "set": ["rules", 0, "param_bounds", "risk_class", "glob"], "value": "*", "valid": false },
    { "name": "two grammars with one id", "set": ["grammars", 1, "id"], "value": "examplectl", "valid": false, "schema": true },
    { "name": "a program read by two grammars", "set": ["grammars", 1, "programs"], "value": ["examplectl"], "valid": false, "schema": true },
    { "name": "a vector with a shell command and an MCP call", "set": ["vectors", 0, "mcp"], "value": { "server": "s", "tool": "t", "args": {} }, "valid": false },
    { "name": "an expected value that is not a digest", "set": ["vectors", 0, "expect", 0, "params", "region"], "value": { "hash": "x" }, "valid": false },
    { "name": "no grammar and no profile", "set": ["grammars"], "value": [], "also": [{ "set": ["profiles"], "value": [] }, { "set": ["vectors"], "value": [{ "id": "nothing", "shell": { "command": "true" }, "expect": [] }] }], "valid": false, "schema": true },
    { "name": "nesting deeper than the limit", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "provider"], "value": { "lower": { "lower": { "lower": { "lower": { "lower": { "lower": { "lower": { "lower": { "lower": { "lower": { "lower": { "lower": { "const": "x" } } } } } } } } } } } } }, "valid": false, "schema": true },
    { "name": "path_options known", "set": ["grammars", 0, "path_options"], "value": "known", "valid": true },
    { "name": "path_options none", "set": ["grammars", 0, "path_options"], "value": "none", "valid": true },
    { "name": "path_options is known or none", "set": ["grammars", 0, "path_options"], "value": "any", "valid": false },
    { "name": "strict_unknown is a boolean", "set": ["grammars", 0, "strict_unknown"], "value": true, "valid": true },
    { "name": "strict_unknown is not a string", "set": ["grammars", 0, "strict_unknown"], "value": "yes", "valid": false },
    { "name": "fallback_on_any_option is a boolean", "set": ["grammars", 0, "fallback_on_any_option"], "value": true, "valid": true },
    { "name": "fallback_only_unread is a boolean", "set": ["grammars", 0, "fallback_only_unread"], "value": 1, "valid": false },
    { "name": "double_dash positionals", "set": ["grammars", 0, "double_dash"], "value": "positionals", "valid": true },
    { "name": "double_dash is end or positionals", "set": ["grammars", 0, "double_dash"], "value": "keep", "valid": false },
    { "name": "unknown_option is a condition", "set": ["grammars", 0, "commands", 1, "when"], "value": { "unknown_option": true }, "valid": true },
    { "name": "unknown_option is only true", "set": ["grammars", 0, "commands", 1, "when"], "value": { "unknown_option": false }, "valid": false },
    { "name": "positionals past an unknown option", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "provider"], "value": { "join": { "positionals": { "from": 0, "past_unknown": true } }, "sep": ", " }, "valid": true },
    { "name": "past_unknown is only true", "set": ["grammars", 0, "commands", 1, "emit", 0, "params", "provider"], "value": { "join": { "positionals": { "from": 0, "past_unknown": false } }, "sep": ", " }, "valid": false }
  ]
}
