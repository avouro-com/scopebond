{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopebond.com/schema/receipt-v1.json",
  "title": "scopebond:receipt evidence contract v1",
  "description": "A countersigned receipt whose signature covers the complete canonical payload. It attests the gateway's recorded decision and adapter assertion; it does not independently prove an external effect or compliance.",
  "type": "object",
  "required": ["payload", "signature"],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "required": ["type", "evidence_version", "canonicalization", "intent", "intent_hash", "action_ref", "policy_hash", "policy_version", "policy_ref", "verifier_version", "realtime_result", "executed", "execution_ref", "execution", "redaction", "authorization", "attester", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "scopebond:receipt" },
        "evidence_version": { "const": "1.0" },
        "canonicalization": { "const": "RFC8785" },
        "intent": {
          "type": "object",
          "description": "The action the agent signed (the ACTA payload_digest source).",
          "required": ["action_type"],
          "properties": {
            "action_type": { "type": "string" },
            "asset": { "type": "string" },
            "amount": { "type": "integer", "minimum": 0 },
            "params": { "type": "object" }
          }
        },
        "intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Compatibility alias of action_ref.authorized_intent_hash." },
        "action_ref": {
          "type": "object",
          "required": ["authorized_intent_hash", "evidence_intent_hash"],
          "additionalProperties": false,
          "properties": {
            "action_id": { "type": "string", "minLength": 16, "maxLength": 200 },
            "authorized_intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "evidence_intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "policy_hash": { "type": "string", "description": "ACTA policy_digest = the registered policy hash." },
        "policy_version": { "type": "integer", "minimum": 1 },
        "policy_ref": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": ["string", "null"] },
            "version": { "type": "integer", "minimum": 1 },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "verifier_version": { "type": "string" },
        "realtime_result": { "enum": ["allow", "deny", "approved", "timeout", "not_evaluated"] },
        "executed": { "type": "boolean" },
        "execution_ref": { "type": ["string", "null"], "description": "Compatibility alias of execution.reference." },
        "execution": {
          "type": "object",
          "required": ["state", "assertion", "reference", "external_effect"],
          "additionalProperties": false,
          "properties": {
            "state": { "enum": ["simulated", "observed_not_evaluated", "denied", "allowed_pending", "cooperative_allow", "executed", "failed", "outcome_unknown", "observed_after"] },
            "assertion": { "enum": ["none", "gateway_simulation", "adapter_reported_success", "adapter_reported_failure", "adapter_outcome_unknown"] },
            "reference": { "type": ["string", "null"] },
            "external_effect": { "const": "not_independently_verified" }
          }
        },
        "redaction": {
          "type": "object",
          "required": ["profile", "paths"],
          "additionalProperties": false,
          "properties": {
            "profile": { "const": "scopebond:minimized-intent/v1" },
            "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "authorization": {
          "oneOf": [
            {
              "type": "object",
              "required": ["mode", "agent", "approval"],
              "additionalProperties": false,
              "properties": {
                "mode": { "const": "authenticated" },
                "agent": { "$ref": "#/$defs/intentAuthorization" },
                "approval": { "oneOf": [{ "$ref": "#/$defs/approval" }, { "type": "null" }] }
              }
            },
            {
              "type": "object",
              "required": ["mode", "agent", "approval"],
              "additionalProperties": false,
              "properties": {
                "mode": { "const": "insecure_development" },
                "agent": { "type": "null" },
                "approval": { "type": "null" }
              }
            },
            {
              "type": "object",
              "description": "No agent authorization — a gate attested a consequence (boundary-class receipts). Identity is the receipt's boundary attribution.",
              "required": ["mode", "agent", "approval"],
              "additionalProperties": false,
              "properties": {
                "mode": { "const": "boundary" },
                "agent": { "type": "null" },
                "approval": { "type": "null" }
              }
            },
            {
              "type": "object",
              "description": "No agent signature — a proxy/PEP decided a request carrying the caller's own identity (pep_authorized receipts). Identity is the receipt's principal.",
              "required": ["mode", "agent", "approval"],
              "additionalProperties": false,
              "properties": {
                "mode": { "const": "pep" },
                "agent": { "type": "null" },
                "approval": { "type": "null" }
              }
            }
          ]
        },
        "attester": {
          "type": "object",
          "required": ["kind", "kid"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["gateway", "module", "resource"] },
            "kid": { "type": "string" }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "evidence_class": { "enum": ["signed_intent", "pep_authorized", "boundary"], "description": "Evidence class (§15). Absent = legacy, inferred at read time. Never upgraded." },
        "principal": {
          "type": "object",
          "description": "Required for pep_authorized: the validated identity subject and issuer.",
          "required": ["subject", "issuer"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 1 },
            "issuer": { "type": "string", "minLength": 1 }
          }
        },
        "boundary": {
          "type": "object",
          "description": "Required for boundary: the gate that decided a consequence and the attributed actor.",
          "required": ["gate", "outcome_ref", "attribution"],
          "additionalProperties": false,
          "properties": {
            "gate": { "enum": ["merge", "deploy", "egress", "platform_event"] },
            "outcome_ref": { "type": "string", "minLength": 1 },
            "attribution": {
              "type": "object",
              "required": ["kind", "actor"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["asserted", "inferred"] },
                "actor": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "context": {
          "type": "object",
          "description": "Optional. Where the receipt was produced, so records can be grouped by session and filtered by tool, model and repository. Carries no local paths, no credentials and no prompts. Covered by the signature like every other payload field. A receipt check that predates this member reports a receipt carrying it as invalid (the payload is closed); verify with a release that knows context.",
          "additionalProperties": false,
          "properties": {
            "harness": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,39}$", "description": "The connector or coding tool that produced the receipt: claude, cursor, codex, copilot, gateway, ..." },
            "harness_version": { "type": ["string", "null"], "minLength": 1, "maxLength": 64, "description": "The version that tool reports, when it reports one." },
            "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "description": "The model id the tool reports, when it reports one." },
            "session_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 200, "description": "An opaque session id the connector assigns (never the tool's raw session id)." },
            "repository": { "type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9][a-z0-9.-]*(/(?![.]{1,2}(/|$))(?!%2[eE])[A-Za-z0-9._~%+-]+){2,}$", "description": "The git remote origin as host/owner/name: lowercase host, no scheme, credentials, query, .git suffix or dot segments (., .., %2e...). Null when unknown; never a local path." },
            "branch": { "type": ["string", "null"], "minLength": 1, "maxLength": 200, "description": "The current branch, when known." }
          }
        },
        "budget": {
          "type": "object",
          "description": "Optional. A session budget counted or refused this action (session-budgets.schema.json): which budget, the action type counted, the count with this action and the limit, and the state. within / at_limit: counted and allowed. over: beyond the limit (denied under enforce, recorded under monitor). unavailable: the hook could not read or write its count, so it denied. A receipt check that predates this member reports a receipt carrying it as invalid (the payload is closed).",
          "additionalProperties": false,
          "required": ["version", "scope", "budget_id", "budget_version", "mode", "operation", "count", "max", "state"],
          "properties": {
            "version": { "const": 1 },
            "scope": { "const": "session" },
            "budget_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
            "budget_version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "mode": { "enum": ["enforce", "monitor"] },
            "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$", "maxLength": 64 },
            "count": { "type": "integer", "minimum": 0, "maximum": 1000001 },
            "max": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "state": { "enum": ["within", "at_limit", "over", "unavailable"] }
          }
        },
        "clause_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Optional. The id of the policy clause that matched (a starter rule such as safe-shell or protect-read, or a pack rule's clause id), on a receipt whose action a clause denied, recorded under monitor (realtime_result deny with the action allowed), held for approval or a person overrode. An allowed action carries none. When several clauses matched, it names an enforced clause first, then one that needs approval, then a monitored one, and among clauses of one mode the first by policy order. Covered by the signature. A receipt check that predates this member reports a receipt carrying it as invalid (the payload is closed)."
        },
        "failed_bound": {
          "type": "string",
          "maxLength": 97,
          "pattern": "^[A-Za-z0-9_.-]{1,64}:[a-z_]{1,32}$",
          "description": "Optional, only with clause_id. The bound of that clause that failed, as <param>:<bound>: the param the clause checked and the clause field it failed (program:pattern, path:pattern, ref:pattern, amount:max_per_action, host:hosts, action_type:action_types, timestamp:hours). It names the param, never the param's value, file contents or secrets."
        },
        "override": {
          "type": "object",
          "description": "A person at the computer allowed an action a rule blocked (agent_dialog, with a reason whose SHA-256 is reason_digest, or with none where the workspace asks for none: reason_digest null and reason_length 0), the coding agent's own permission prompt was offered for it (harness_prompt), or it matched a standing allowance (allowance: repeat_of names the allowance and reason_digest is the SHA-256 of the reason it was made with). Present only with realtime_result \"approved\".",
          "required": ["version", "rule", "method", "state", "repeat_of", "reason_digest", "reason_length", "os_user_digest", "decided_at"],
          "additionalProperties": false,
          "properties": {
            "version": { "const": 1 },
            "rule": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
            "method": { "enum": ["agent_dialog", "harness_prompt", "allowance"] },
            "state": { "enum": ["allowed", "offered"] },
            "repeat_of": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 16, "maxLength": 200 }] },
            "reason_digest": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
            "reason_length": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 500 }] },
            "os_user_digest": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
            "decided_at": { "type": "string", "format": "date-time" }
          },
          "oneOf": [
            { "properties": { "method": { "const": "agent_dialog" }, "state": { "const": "allowed" } }, "oneOf": [{ "properties": { "reason_digest": { "type": "string" }, "reason_length": { "type": "integer", "minimum": 1 } } }, { "properties": { "reason_digest": { "type": "null" }, "reason_length": { "const": 0 } } }] },
            { "properties": { "method": { "const": "harness_prompt" }, "state": { "const": "offered" }, "reason_digest": { "type": "null" }, "reason_length": { "type": "null" }, "repeat_of": { "type": "null" } } },
            { "properties": { "method": { "const": "allowance" }, "state": { "const": "allowed" }, "repeat_of": { "type": "string" } }, "oneOf": [{ "properties": { "reason_digest": { "type": "string" }, "reason_length": { "type": "integer", "minimum": 1 } } }, { "properties": { "reason_digest": { "type": "null" }, "reason_length": { "const": 0 } } }] }
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["override"] },
          "then": { "properties": { "realtime_result": { "const": "approved" } } }
        },
        {
          "if": { "required": ["failed_bound"] },
          "then": { "required": ["clause_id"] }
        },
        {
          "if": { "required": ["clause_id"] },
          "then": { "properties": { "realtime_result": { "enum": ["deny", "approved", "timeout"] } } }
        },
        {
          "if": { "required": ["evidence_class"], "properties": { "evidence_class": { "const": "boundary" } } },
          "then": { "required": ["boundary"], "not": { "required": ["principal"] } },
          "else": { "not": { "required": ["boundary"] } }
        },
        {
          "if": { "required": ["evidence_class"], "properties": { "evidence_class": { "const": "pep_authorized" } } },
          "then": { "required": ["principal"], "not": { "required": ["boundary"] } },
          "else": { "not": { "required": ["principal"] } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "state": { "enum": ["executed", "observed_after"] } } } } },
          "then": { "properties": { "executed": { "const": true } } },
          "else": { "properties": { "executed": { "const": false } } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "state": { "const": "observed_after" } } } } },
          "then": { "properties": { "realtime_result": { "const": "deny" }, "execution": { "properties": { "assertion": { "const": "none" } } } } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "state": { "const": "simulated" } } } } },
          "then": { "properties": { "execution": { "properties": { "assertion": { "const": "gateway_simulation" } } } } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "state": { "const": "observed_not_evaluated" } } } } },
          "then": { "properties": { "realtime_result": { "const": "not_evaluated" } } },
          "else": { "properties": { "realtime_result": { "not": { "const": "not_evaluated" } } } }
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": ["alg", "sig"],
      "additionalProperties": false,
      "properties": {
        "alg": { "enum": ["Ed25519", "ES256", "secp256k1", "EIP-712"] },
        "sig": { "type": "string" }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["kid", "alg"],
      "additionalProperties": false,
      "properties": {
        "kid": { "type": "string", "pattern": "^key:[0-9a-f]{16}$" },
        "alg": { "const": "Ed25519" }
      }
    },
    "intentAuthorization": {
      "type": "object",
      "required": ["version", "request_id", "issued_at", "expires_at", "signer", "intent_hash", "signature"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "signer": { "$ref": "#/$defs/identity" },
        "intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "minLength": 40 }
      }
    },
    "approval": {
      "type": "object",
      "required": ["version", "approval_id", "issued_at", "expires_at", "approver", "intent_hash", "policy_ref", "decision", "signature"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "approval_id": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "approver": { "$ref": "#/$defs/identity" },
        "intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "policy_ref": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": ["string", "null"] },
            "version": { "type": "integer", "minimum": 1 },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "decision": { "const": "approve" },
        "signature": { "type": "string", "minLength": 40 }
      }
    }
  }
}
