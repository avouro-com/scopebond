{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopebond.com/schema/receipt-v1.json",
  "title": "scopebond:receipt evidence contract v1",
  "description": "A countersigned receipt whose signature covers the complete canonical payload. It attests the gateway's recorded decision and adapter assertion; it does not independently prove an external effect or compliance.",
  "type": "object",
  "required": ["payload", "signature"],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "required": ["type", "evidence_version", "canonicalization", "intent", "intent_hash", "action_ref", "policy_hash", "policy_version", "policy_ref", "verifier_version", "realtime_result", "executed", "execution_ref", "execution", "redaction", "authorization", "attester", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "scopebond:receipt" },
        "evidence_version": { "const": "1.0" },
        "canonicalization": { "const": "RFC8785" },
        "intent": {
          "type": "object",
          "description": "The action the agent signed (the ACTA payload_digest source).",
          "required": ["action_type"],
          "properties": {
            "action_type": { "type": "string" },
            "asset": { "type": "string" },
            "amount": { "type": "integer", "minimum": 0 },
            "params": { "type": "object" }
          }
        },
        "intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Compatibility alias of action_ref.authorized_intent_hash." },
        "action_ref": {
          "type": "object",
          "required": ["authorized_intent_hash", "evidence_intent_hash"],
          "additionalProperties": false,
          "properties": {
            "action_id": { "type": "string", "minLength": 16, "maxLength": 200 },
            "authorized_intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "evidence_intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "policy_hash": { "type": "string", "description": "ACTA policy_digest = the registered policy hash." },
        "policy_version": { "type": "integer", "minimum": 1 },
        "policy_ref": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": ["string", "null"] },
            "version": { "type": "integer", "minimum": 1 },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "verifier_version": { "type": "string" },
        "realtime_result": { "enum": ["allow", "deny", "approved", "timeout", "not_evaluated"] },
        "executed": { "type": "boolean" },
        "execution_ref": { "type": ["string", "null"], "description": "Compatibility alias of execution.reference." },
        "execution": {
          "type": "object",
          "required": ["state", "assertion", "reference", "external_effect"],
          "additionalProperties": false,
          "properties": {
            "state": { "enum": ["simulated", "observed_not_evaluated", "denied", "allowed_pending", "cooperative_allow", "executed", "failed", "outcome_unknown"] },
            "assertion": { "enum": ["none", "gateway_simulation", "adapter_reported_success", "adapter_reported_failure", "adapter_outcome_unknown"] },
            "reference": { "type": ["string", "null"] },
            "external_effect": { "const": "not_independently_verified" }
          }
        },
        "redaction": {
          "type": "object",
          "required": ["profile", "paths"],
          "additionalProperties": false,
          "properties": {
            "profile": { "const": "scopebond:minimized-intent/v1" },
            "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "authorization": {
          "oneOf": [
            {
              "type": "object",
              "required": ["mode", "agent", "approval"],
              "additionalProperties": false,
              "properties": {
                "mode": { "const": "authenticated" },
                "agent": { "$ref": "#/$defs/intentAuthorization" },
                "approval": { "oneOf": [{ "$ref": "#/$defs/approval" }, { "type": "null" }] }
              }
            },
            {
              "type": "object",
              "required": ["mode", "agent", "approval"],
              "additionalProperties": false,
              "properties": {
                "mode": { "const": "insecure_development" },
                "agent": { "type": "null" },
                "approval": { "type": "null" }
              }
            }
          ]
        },
        "attester": {
          "type": "object",
          "required": ["kind", "kid"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["gateway", "module", "resource"] },
            "kid": { "type": "string" }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "execution": { "properties": { "state": { "const": "executed" } } } } },
          "then": { "properties": { "executed": { "const": true } } },
          "else": { "properties": { "executed": { "const": false } } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "state": { "const": "simulated" } } } } },
          "then": { "properties": { "execution": { "properties": { "assertion": { "const": "gateway_simulation" } } } } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "state": { "const": "observed_not_evaluated" } } } } },
          "then": { "properties": { "realtime_result": { "const": "not_evaluated" } } },
          "else": { "properties": { "realtime_result": { "not": { "const": "not_evaluated" } } } }
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": ["alg", "sig"],
      "additionalProperties": false,
      "properties": {
        "alg": { "enum": ["Ed25519", "ES256", "secp256k1", "EIP-712"] },
        "sig": { "type": "string" }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["kid", "alg"],
      "additionalProperties": false,
      "properties": {
        "kid": { "type": "string", "pattern": "^key:[0-9a-f]{16}$" },
        "alg": { "const": "Ed25519" }
      }
    },
    "intentAuthorization": {
      "type": "object",
      "required": ["version", "request_id", "issued_at", "expires_at", "signer", "intent_hash", "signature"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "signer": { "$ref": "#/$defs/identity" },
        "intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "minLength": 40 }
      }
    },
    "approval": {
      "type": "object",
      "required": ["version", "approval_id", "issued_at", "expires_at", "approver", "intent_hash", "policy_ref", "decision", "signature"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "approval_id": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "approver": { "$ref": "#/$defs/identity" },
        "intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "policy_ref": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": ["string", "null"] },
            "version": { "type": "integer", "minimum": 1 },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "decision": { "const": "approve" },
        "signature": { "type": "string", "minLength": 40 }
      }
    }
  }
}
