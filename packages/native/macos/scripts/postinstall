#!/bin/sh
# After the package's files are in place: start the agent now for each person signed in to this Mac (launchd starts it
# from /Library/LaunchAgents at every later sign-in). A person for whom launchd has the label disabled stays without it.
# An install with nobody signed in (a management tool at the login window) starts it at the next sign-in. Nothing here
# ever fails the install.
LABEL=com.scopebond.agent
PLIST="/Library/LaunchAgents/$LABEL.plist"

for uid in $(/bin/ps -axo uid=,comm= | /usr/bin/awk '$1 != 0 && $2 ~ /\/loginwindow$/ { print $1 }' | /usr/bin/sort -u); do
  /bin/launchctl bootstrap "gui/$uid" "$PLIST" 2>/dev/null || true
done
exit 0
