<?xml version="1.0" encoding="utf-8"?>
<!--
  The Scopebond Agent for Windows: the single executable (agent + hook), installed per user by default
  (%LOCALAPPDATA%\Programs\Scopebond, no administrator prompt) or for every user with ALLUSERS=1 (Program Files; Intune,
  Group Policy). Built by build-msi.mjs with WiX 5; signed with the executable in the release workflow.

    msiexec /i scopebond-agent-<version>-x64.msi /qn                     per user, silent
    msiexec /i scopebond-agent-<version>-x64.msi /qn ALLUSERS=1          every user
    msiexec /i … WORKSPACE=https://cloud.scopebond.com                   the workspace `setup` connects to

  Removing it runs `scopebond-agent.exe uninstall` first, as the person removing it: autostart off, the agent stopped,
  the hook taken out of the coding agents' settings and the workspace told. The Scopebond folder (keys, receipts) stays.

  Built with the native tray (build-msi.mjs passes TrayPath), it also installs scopebond-tray.exe, starts it at sign-in
  (a Run value named Scopebond, for this user or, with ALLUSERS=1, for every user), starts it at the end of a per-user
  install, and closes it before files are replaced or removed. The tray starts the agent and keeps it running.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Scopebond Agent" Manufacturer="Avouro LLC" Version="$(var.Version)" UpgradeCode="{92E9376F-D496-4CBE-A4B5-0E860E488A44}"
           Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Scopebond Agent: guardrails and signed records for AI coding agents" Manufacturer="Avouro LLC" />
    <!-- The new version is installed before the old one leaves, so the hook's executable is never missing for long. -->
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="A newer Scopebond Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WORKSPACE" Secure="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://scopebond.com" />
    <Property Id="ARPHELPLINK" Value="https://github.com/avouro-com/scopebond" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Scopebond">
        <Component Id="AgentExecutable">
          <File Id="AgentExe" Source="$(var.ExePath)" Name="scopebond-agent.exe" KeyPath="yes" />
        </Component>
<?ifdef TrayPath?>
        <Component Id="TrayExecutable">
          <File Id="TrayExe" Source="$(var.TrayPath)" Name="scopebond-tray.exe" KeyPath="yes" />
        </Component>
        <!-- At sign-in: the tray, which starts the agent. -->
        <Component Id="TrayAtSignIn">
          <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Scopebond" Type="string"
                         Value="&quot;[INSTALLFOLDER]scopebond-tray.exe&quot;" KeyPath="yes" />
        </Component>
<?endif?>
        <Component Id="InstallSettings">
          <RegistryValue Root="HKMU" Key="Software\Avouro\Scopebond" Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
        <Component Id="WorkspaceSetting" Condition="WORKSPACE">
          <RegistryValue Root="HKMU" Key="Software\Avouro\Scopebond" Name="Workspace" Type="string" Value="[WORKSPACE]" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- One Start-menu entry: the agent's status (the tray's status panel, or the status in a window without the tray). Its
         AppUserModelID lets notifications name Scopebond. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
<?ifdef TrayPath?>
        <Shortcut Id="StatusShortcut" Name="Scopebond Agent status" Description="What the Scopebond Agent reports about this computer"
                  Target="[INSTALLFOLDER]scopebond-tray.exe" Arguments="--status" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Avouro.Scopebond" />
        </Shortcut>
<?else?>
        <Shortcut Id="StatusShortcut" Name="Scopebond Agent status" Description="What the Scopebond Agent reports about this computer"
                  Target="[System64Folder]cmd.exe" Arguments="/k &quot;&quot;[INSTALLFOLDER]scopebond-agent.exe&quot; status&quot;" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Avouro.Scopebond" />
        </Shortcut>
<?endif?>
        <RegistryValue Root="HKMU" Key="Software\Avouro\Scopebond" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Scopebond Agent">
      <ComponentRef Id="AgentExecutable" />
      <ComponentRef Id="InstallSettings" />
      <ComponentRef Id="WorkspaceSetting" />
      <ComponentRef Id="StartMenuShortcut" />
<?ifdef TrayPath?>
      <ComponentRef Id="TrayExecutable" />
      <ComponentRef Id="TrayAtSignIn" />
<?endif?>
    </Feature>
<?ifdef TrayPath?>
    <!-- The tray holds its own file open and would start the agent again: it is closed before any file is replaced or
         removed (install, upgrade, removal), without a reboot prompt. -->
    <util:CloseApplication Id="CloseTray" Target="scopebond-tray.exe" TerminateProcess="1" Timeout="2" RebootPrompt="no" />
    <!-- After a per-user install or upgrade, the tray starts now (it starts the agent), as the person installing. Not for an
         install for every user, which may run as the system account: each person's sign-in starts it. -->
    <CustomAction Id="StartTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]scopebond-tray.exe&quot;" Execute="immediate"
                  Impersonate="yes" Return="asyncNoWait" />
<?endif?>

    <!-- On removal (not on an upgrade), before the files go: the agent's own uninstall, as the person removing it, with no
         window. A failure never stops the removal. -->
    <SetProperty Id="ReportUninstall" Value="&quot;[INSTALLFOLDER]scopebond-agent.exe&quot; uninstall" Before="ReportUninstall" Sequence="execute" />
    <CustomAction Id="ReportUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="ReportUninstall" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
<?ifdef TrayPath?>
      <Custom Action="StartTray" After="InstallFinalize" Condition="NOT REMOVE AND ALLUSERS &lt;&gt; &quot;1&quot;" />
<?endif?>
    </InstallExecuteSequence>
  </Package>
</Wix>
